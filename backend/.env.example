# Backend-only environment (used when running the API outside Docker).
# Copy to backend/.env. Never commit the real file.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://teamboard:your-password@localhost:5432/teamboard?schema=public
DATABASE_URL_TEST=postgresql://teamboard:your-password@localhost:5432/teamboard_test?schema=public

SESSION_COOKIE_NAME=teamboard_session
CSRF_COOKIE_NAME=teamboard_csrf
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
# false only for plain-HTTP local development
COOKIE_SECURE=false

CORS_ORIGIN=https://localhost:5180,http://localhost:5180
APP_URL=https://localhost:5180
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=3

ENABLE_PUBLIC_REGISTRATION=false
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local

SEED_ADMIN_EMAIL=admin@your-domain.test
SEED_ADMIN_PASSWORD=First_Login_ChangeMe_9!
SEED_PROJECT_CODE=WEBAPP
SEED_TIMEZONE=Asia/Manila

LOG_LEVEL=info
SCHEDULER_ENABLED=false

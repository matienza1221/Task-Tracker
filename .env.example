# ---------------------------------------------------------------------------
# TeamBoard — shared environment (docker compose reads this file)
# Copy to `.env` and set real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=teamboard
# Required. Use a long random value in production.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=teamboard
# Host port for the database (development only)
DB_PORT=5432

# --- Ports -------------------------------------------------------------------
API_PORT=4000
WEB_PORT=5180

# --- Sessions / cookies ------------------------------------------------------
SESSION_COOKIE_NAME=teamboard_session
CSRF_COOKIE_NAME=teamboard_csrf
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
# true in development because the dev stack runs over HTTPS with local certs
COOKIE_SECURE=true

# --- Origins -----------------------------------------------------------------
# Comma-separated allowlist. Production: your real https origin.
CORS_ORIGIN=https://localhost:5180,http://localhost:5180
APP_URL=https://localhost:5180

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=3

# --- Features ----------------------------------------------------------------
ENABLE_PUBLIC_REGISTRATION=false
MAX_UPLOAD_MB=10
STORAGE_PROVIDER=local

# --- Bootstrap admin (seed only) ---------------------------------------------
# The password must meet the strength policy (12+ chars, 3 character classes,
# must not contain the email local part or display name). Change it on first sign-in.
SEED_ADMIN_EMAIL=admin@your-domain.test
SEED_ADMIN_PASSWORD=First_Login_ChangeMe_9!
SEED_PROJECT_CODE=WEBAPP
SEED_TIMEZONE=Asia/Manila

# --- Ops ---------------------------------------------------------------------
LOG_LEVEL=info
SCHEDULER_ENABLED=true

# Frontend environment. Only VITE_* variables are exposed to the browser bundle.
# NEVER put secrets here — anything in this file ships to users.

# API base path. Keep "/api": nginx/Vite proxy to the API container.
VITE_API_URL=/api

# Development proxy target (Vite dev server only; not used in production builds)
VITE_API_PROXY_TARGET=http://localhost:4000

# Directory containing dev.crt / dev.key for the HTTPS dev server (optional)
# CERTS_DIR=../certs
